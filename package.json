{
  "name": "api-gateway-core",
  "version": "1.0.0",
  "description": "Production-ready TypeScript API Gateway core library with middleware, utilities, and type definitions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "INTEGRATION.md",
    "GETTING_STARTED.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts,.tsx --no-error-on-unmatched-pattern",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev": "ts-node src/index.ts",
    "prepublishOnly": "npm run clean 2>/dev/null || true; npm run build && npm test"
  },
  "keywords": [
    "api-gateway",
    "typescript",
    "express",
    "middleware",
    "validation",
    "error-handling",
    "pagination",
    "filtering"
  ],
  "author": "API Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "zod": "^3.22.4",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/api-gateway-core.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/api-gateway-core/issues"
  },
  "homepage": "https://github.com/yourusername/api-gateway-core#readme"
}